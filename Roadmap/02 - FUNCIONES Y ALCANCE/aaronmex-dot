"""
Crea una función que reciba dos parámetros de tipo cadena de texto y retorne un número.
- La función imprime todos los números del 1 al 100. Teniendo en cuenta que:
- Si el número es múltiplo de 3, muestra la cadena de texto del primer parámetro.
- Si el número es múltiplo de 5, muestra la cadena de texto del segundo parámetro.
- Si el número es múltiplo de 3 y de 5, muestra las dos cadenas de texto concatenadas.
- La función retorna el número de veces que se ha impreso el número en lugar de los textos.
"""

def function(parametro1 , parametro2):
    # Para hacer que retorne un numero, debemos cambiar de string a integer
    conteo = 0 # comienza desde cero porque desde ahi nos lo han pedido
    # Usaremos un for loop para imprimir todos los numeros del 1 al 100
    for i in range(1, 101):
            if i % 3 == 0 and i % 5 == 0:
                print(parametro1 + parametro2)
            elif i % 3 == 0:
                print(parametro1)
            elif i % 5 == 0:
                print(parametro2)
            else:
                print(i)
                conteo += 1
    
    
    return conteo
    
print( function ('Hola', ' Mundo'))
        
